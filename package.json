{
  "name": "teemo-tween",
  "version": "0.1.1",
  "description": "One-line tweens, sequences and game-feel presets for web games, built on GSAP.",
  "license": "MIT",
  "author": "Dominik Biškupović",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "tween",
    "animation",
    "gsap",
    "game",
    "game-feel",
    "juice",
    "shake",
    "punch",
    "sequence",
    "react"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "default": "./dist/presets.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown --silent",
    "dev": "vite demo",
    "build:demo": "vite build demo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --reporter=dot",
    "size": "size-limit",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "docs": "typedoc",
    "check": "scripts/check.sh",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "scripts/release.sh"
  },
  "peerDependencies": {
    "gsap": "^3.13.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "gsap": "^3.15.1",
    "jsdom": "^31.0.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^14.3.0",
    "tsdown": "^0.23.7",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dominikbiskupovic/teemo-tween.git"
  },
  "homepage": "https://dominikbiskupovic.github.io/teemo-tween/",
  "bugs": {
    "url": "https://github.com/dominikbiskupovic/teemo-tween/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
